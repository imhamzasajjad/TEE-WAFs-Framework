# Current experiment: XSS dataset with the XSS-WAF ML provider
# ML provider: wafbrain (default), ml_based_waf, or xss_waf
#
# Sources:
#   wafbrain:     https://github.com/BBVA/waf-brain
#   ml_based_waf: https://github.com/vladan-stojnic/ML-based-WAF
#   xss_waf:      https://github.com/Jeff-Rowell/XSS-WAF

# Dataset analysis options: yes/on/true/1 or no/off/false/0
ANALYZE_DATASET=no

# ML provider options: wafbrain, ml_based_waf, xss_waf
ML_WAF_PROVIDER=ml_based_waf

# Fuzzer options: sql, xss, html, javascript
FUZZER_TYPE=xss

# Dataset CSV. It must contain a payload column and a status/label column.
PAYLOADS_FILE=client/Dataset/xss_payloads.csv

# Number of source payloads selected randomly for this run.
NUM_SAMPLES=5

# Number of mutations generated for each selected payload.
NUM_FUZZING_ROUNDS=60

# Payload scope options:
#   malicious_only = fuzz only rows labelled 403 (adversarial-evasion testing)
#   both           = include malicious and benign rows (mixed evaluation)
PAYLOAD_SCOPE=malicious_only

# Maximum XSS mutation length. SQL fuzzing is unchanged by this setting.
MAX_MUTATED_LENGTH=2048
